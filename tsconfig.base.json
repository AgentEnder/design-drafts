{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "types": [
      "*"
    ],
    "esModuleInterop": false,
    "ignoreDeprecations": "6.0"
  }
}
